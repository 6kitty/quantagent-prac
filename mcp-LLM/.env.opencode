# ============================================================
# opencode + oh-my-opencode 환경변수 템플릿
# 복사 후 실제 값 입력: cp .env.opencode ~/.env.opencode
# 그리고 셸 rc 파일에 추가: source ~/.env.opencode
# ============================================================

# ── Alibaba Cloud / DashScope (Qwen3-Coder) ────────────────
# https://dashscope.aliyun.com → API Keys
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 리전 선택 (해당 baseURL로 opencode.json 수정)
# 국제: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 미국: https://dashscope-us.aliyuncs.com/compatible-mode/v1
# 중국: https://dashscope.aliyuncs.com/compatible-mode/v1

# ── Azure OpenAI – Codex (gpt-5-codex) ─────────────────────
# Azure Portal → Azure OpenAI → 리소스 이름 & 키
AOAI_RESOURCE_NAME=your-resource-name        # e.g. my-aoai-eastus
AOAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── GitHub (MCP server-github) ──────────────────────────────
# https://github.com/settings/tokens (repo, read:org 권한)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Brave Search (MCP server-brave-search) ──────────────────
# https://api.search.brave.com
BRAVE_API_KEY=BSA_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Exa AI (oh-my-opencode 내장 websearch MCP) ──────────────
# https://dashboard.exa.ai
EXA_API_KEY=exa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
